# Tommy-manus — Nginx site
# Primary hosting is Vercel (HTTPS). ECS only redirects leftover HTTP hits.
# Placeholders: __DOMAIN__ __WWW_DOMAIN__ __WEB_ROOT__

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ __WWW_DOMAIN__;

    # Force HTTPS on the canonical www host (Vercel).
    return 301 https://__WWW_DOMAIN__$request_uri;
}
