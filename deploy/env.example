# Copy to deploy/.env and fill in values. Never commit deploy/.env.

# ECS SSH
DEPLOY_HOST=1.2.3.4
DEPLOY_USER=root
# Optional: DEPLOY_SSH_KEY=~/.ssh/id_rsa
# Optional: DEPLOY_PORT=22

# Remote static root (must match Nginx root)
WEB_ROOT=/var/www/tommy

# Domain (for Nginx server_name + Certbot)
DOMAIN=example.com
WWW_DOMAIN=www.example.com

# First-time server bootstrap: 1 = install Nginx + write site config
SETUP_SERVER=0

# HTTPS via Let's Encrypt (requires DOMAIN DNS already pointing to ECS)
ENABLE_SSL=0
CERTBOT_EMAIL=you@example.com
